# Game Server Shard (PLAN_split_6_services.md §3.1) - the process that actually runs GameSessions,
# connected only to NATS (and, for now, the same SQLite file the monolith uses - see
# GameServerShardMain's javadoc for why that's a known, deliberately-deferred rough edge until §3.5).
#
# Deliberately a second, near-duplicate Dockerfile rather than one generalized with a build-arg -
# that consolidation (single Dockerfile, build-arg picks the jar/mainClass) is explicitly §3.7's job
# once all 5 new processes exist; doing it now for just this one would be solving half the problem
# twice.

# --- build stage ---
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY pom.xml .
COPY src ./src
COPY test ./test
COPY assets ./assets
RUN mvn -q package -DskipTests

# --- runtime stage ---
FROM eclipse-temurin:17-jre
WORKDIR /app
# maven-shade-plugin names the attached artifact "<artifactId>-<version>-shard.jar" (see pom.xml's
# shard-jar execution) - wildcard so a version bump doesn't break this, same as the server Dockerfile.
COPY --from=build /build/target/kungfu-chess-*-shard.jar app.jar
# GameSession reads assets/board.csv (relative path) for the starting position.
COPY --from=build /build/assets/board.csv assets/board.csv

ENTRYPOINT ["java", "-jar", "app.jar"]
