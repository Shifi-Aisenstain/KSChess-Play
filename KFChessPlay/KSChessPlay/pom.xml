<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.kamatech.ctd26</groupId>
    <artifactId>kungfu-chess</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.1</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.5.4</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.44.1.0</version>
        </dependency>

        <!-- Server_Design.md step 5: PostgresUserRepository behind the existing UserRepository
             interface, alongside SqliteUserRepository - SQLite stays the default for local dev/demo,
             Postgres is a config switch for production (see server.config.PersistenceConfig). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.13</version>
        </dependency>

        <!-- Internal service-to-service bus for the 6-way split (Server_Design.md §3.3) -
             WS Gateway <-> Game Server Shards, Matchmaker <-> Game Allocator, etc. -->
        <dependency>
            <groupId>io.nats</groupId>
            <artifactId>jnats</artifactId>
            <version>2.26.0</version>
        </dependency>

        <!-- Server_Design.md step 4: shared state once there's more than one process instance -
             the Matchmaker's waiting-queue and the Game Allocator's active-room/reconnect registry
             (see shared.redis, server.matchmaking.RedisWaitingPlayersQueue, and
             server.allocator.RedisActiveRoomRegistry). A plain, synchronous client (no reactive/async
             API) matches this project's existing "no heavy framework" style, same reasoning as jnats. -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>5.1.0</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>kungfu-chess</finalName>
        <sourceDirectory>src</sourceDirectory>
        <!-- Tests live in test/Test/{unit,integration} (package Test.unit / Test.integration), a
             sibling of src/, not Maven's default src/test/java - point Maven at it directly. -->
        <testSourceDirectory>test</testSourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <!-- Explicit annotationProcessorPaths for Lombok. Without this, a *clean* `mvn
                     compile`/`mvn test` from the command line silently skips annotation processing
                     on this plugin/JDK combo (implicit classpath-based auto-discovery of Lombok's
                     processor doesn't trigger) - every @Getter/@AllArgsConstructor-generated
                     method/constructor then "doesn't exist" and the build fails with a wall of
                     "cannot find symbol" errors across every Lombok-annotated class (Piece,
                     Position, MoveCommand, the eventbus events, CooldownHighlight, etc.). This was
                     masked as long as target/classes still had stale-but-present classes compiled
                     by IntelliJ's own (correctly Lombok-aware) incremental compiler; it surfaces the
                     moment Maven actually has to recompile from scratch. build-and-run.ps1's manual
                     javac fallback already carried the equivalent fix (see its own comment) - this
                     applies the same fix to the real `mvn compile`/`package`/`test` path. -->
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.46</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.2</version>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <!-- Excludes Swing UI (needs GUI automation, not plain JUnit), raw WebSocket
                     transport (needs a live socket), and composition-root entry points from the
                     coverage target - see ARCHITECTURE.md §13/§14 for the full rationale. Applies
                     to both `report` and `check` below; `prepare-agent` still instruments/records
                     everything, this only filters what counts toward the reported/enforced ratio. -->
                <configuration>
                    <excludes>
                        <exclude>Main.class</exclude>
                        <!-- Composition-root wiring, extracted out of the various process Main
                             classes below - only exercised by a real main()/live SQLite file/live
                             socket, and otherwise plain constructor-wiring with no branching logic
                             worth unit testing. server.ServerController/GameServicesConfig/
                             server.rpc.MonolithBusGateway (the pre-§3.3/§3.4 monolith remainder and
                             its bus front door) were deleted outright rather than excluded here: once
                             Matchmaking (§3.3) and room/allocation (§3.4) moved to their own
                             processes, that monolith had zero responsibilities left - RoomManager/
                             MatchmakingService moved out, and its AuthService copy was already dead
                             (login has run entirely inside server.gateway.WsGatewayMain's own copy
                             since §3.2). §3.5's ApiGatewayMain will occupy this slot for real. -->
                        <exclude>server/config/PersistenceConfig*.class</exclude>
                        <!-- WS Gateway composition root + its handler-registration wiring
                             (PLAN_split_6_services.md §3.2). Same rationale as the other composition
                             roots here: only exercised by a real main()/live NATS connection/live
                             socket, or plain constructor-wiring with no branching logic worth unit
                             testing. -->
                        <exclude>server/gateway/WsGatewayMain*.class</exclude>
                        <exclude>server/gateway/GatewayDispatcherFactory*.class</exclude>
                        <exclude>view/GameWindow*.class</exclude>
                        <exclude>client/ui/HomeScreen*.class</exclude>
                        <exclude>client/ui/RoomDialog*.class</exclude>
                        <exclude>view/GameLoop*.class</exclude>
                        <exclude>client/ui/AnimationSubscriber*.class</exclude>
                        <exclude>client/ui/ScoreboardSubscriber*.class</exclude>
                        <exclude>server/net/ChessWebSocketServer*.class</exclude>
                        <exclude>client/net/ServerConnection*.class</exclude>
                        <!-- Needs a live NATS server to exercise for real; InMemoryMessageBus (the
                             test double implementing the same MessageBus interface) is what's
                             actually unit tested - see MessageBusTest. -->
                        <exclude>shared/bus/NatsMessageBus*.class</exclude>
                        <!-- Server_Design.md step 4: same reasoning as NatsMessageBus above - these
                             need a live Redis server to exercise for real; the InMemory* doubles
                             implementing the same interfaces are what's actually unit tested (see
                             WaitingPlayersQueueTest/ActiveRoomRegistryTest). -->
                        <exclude>shared/redis/RedisConnectionProvider*.class</exclude>
                        <exclude>server/matchmaking/RedisWaitingPlayersQueue*.class</exclude>
                        <exclude>server/allocator/RedisActiveRoomRegistry*.class</exclude>
                        <exclude>server/auth/RedisSessionStore*.class</exclude>
                        <!-- Server_Design.md step 5: same reasoning again - these need a live
                             Postgres server to exercise for real; SqliteUserRepository (already
                             covered by SqliteUserRepositoryTest against a real temp-file SQLite db)
                             proves the shared UserRepository contract these implement identically. -->
                        <exclude>server/persistence/PostgresConnectionProvider*.class</exclude>
                        <exclude>server/persistence/PostgresSchemaInitializer*.class</exclude>
                        <exclude>server/auth/PostgresUserRepository*.class</exclude>
                        <!-- Same reasoning: needs a live Postgres; SqliteGameHistoryRepository (covered
                             by SqliteGameHistoryRepositoryTest against a real temp-file SQLite db)
                             proves the shared GameHistoryRepository contract identically. -->
                        <exclude>server/persistence/PostgresGameHistoryRepository*.class</exclude>
                        <!-- Game Server Shard composition root (PLAN_split_6_services.md §3.1) - same
                             rationale as the other composition roots here. Its actual logic lives in
                             GameShardRuntime, which *is* unit tested (against InMemoryMessageBus). -->
                        <exclude>server/shard/GameServerShardMain*.class</exclude>
                        <!-- Matchmaker composition root (PLAN_split_6_services.md §3.3) - same
                             rationale. Its actual logic lives in MatchmakerRuntime, which *is* unit
                             tested (against InMemoryMessageBus). -->
                        <exclude>server/matchmaking/MatchmakerMain*.class</exclude>
                        <!-- Game Allocator composition root (PLAN_split_6_services.md §3.4) - same
                             rationale. Its actual logic lives in GameAllocatorRuntime, which *is* unit
                             tested (against InMemoryMessageBus). -->
                        <exclude>server/allocator/GameAllocatorMain*.class</exclude>
                        <!-- API Gateway composition root (PLAN_split_6_services.md §3.5) - same
                             rationale. Its REST handler logic lives in LoginRestHandler, which *is*
                             unit tested (against a real loopback HttpServer - see LoginRestHandlerTest). -->
                        <exclude>server/apigateway/ApiGatewayMain*.class</exclude>
                        <!-- Elo writer composition root (Server_Design.md step 5) - same rationale.
                             Its actual batching logic lives in EloWriterRuntime, which *is* unit
                             tested (against InMemoryMessageBus and a fake UserRepository). -->
                        <exclude>server/persistence/EloWriterMain*.class</exclude>
                        <exclude>loadtest/LoadTestMain*.class</exclude>
                        <exclude>loadtest/SimulatedPlayer*.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <!-- Applies as shared defaults to every execution below. Without this, merging a
                     signed dependency's jar (the Postgres driver and/or something it pulls in
                     transitively) into any of these fat jars leaves its old META-INF/*.SF/.RSA/.DSA
                     signature files behind pointing at a manifest that no longer matches the merged
                     contents - the JVM then refuses to even start the jar with
                     "java.lang.SecurityException: Invalid signature file digest for Manifest main
                     attributes". Stripping those files (a fat jar isn't signed as a whole anyway) is
                     the standard, universally-recommended fix for this exact shade-plugin gotcha. -->
                <configuration>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                            </excludes>
                        </filter>
                    </filters>
                </configuration>
                <executions>
                    <execution>
                        <id>client-jar</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>client</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                    <!-- Game Server Shard (PLAN_split_6_services.md §3.1) - the first of the 6
                         components in Server_Design.md §1 to get its own runnable jar/mainClass. -->
                    <execution>
                        <id>shard-jar</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>shard</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>server.shard.GameServerShardMain</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>

                    <!-- WS Gateway (PLAN_split_6_services.md §3.2) - the second of the 6 components
                         to get its own runnable jar/mainClass. -->
                    <execution>
                        <id>gateway-jar</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>gateway</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>server.gateway.WsGatewayMain</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>

                    <!-- Matchmaker (PLAN_split_6_services.md §3.3) - the third of the 6 components
                         to get its own runnable jar/mainClass. -->
                    <execution>
                        <id>matchmaker-jar</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>matchmaker</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>server.matchmaking.MatchmakerMain</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>

                    <!-- Game Allocator (PLAN_split_6_services.md §3.4) - the fourth of the 6
                         components to get its own runnable jar/mainClass. -->
                    <execution>
                        <id>allocator-jar</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>allocator</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>server.allocator.GameAllocatorMain</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>

                    <!-- API Gateway (PLAN_split_6_services.md §3.5) - the fifth of the 6 components
                         listed in Server_Design.md §1 to get its own runnable jar/mainClass. All 5
                         backend processes' jars build from one build-arg-driven Dockerfile (§3.7,
                         JAR_CLASSIFIER picks which classifier ends up as app.jar) instead of a
                         5th near-duplicate Dockerfile.apigateway. -->
                    <execution>
                        <id>apigateway-jar</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>apigateway</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>server.apigateway.ApiGatewayMain</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>

                    <!-- Elo writer (Server_Design.md step 5) - not one of the original 6 components
                         (Server_Design.md §1/§4 lists "Persistence writers" as its own capacity-
                         planning row though), added once async/batched persistence needed a real
                         consumer process for BusEloWriter's NATS messages. -->
                    <execution>
                        <id>elowriter-jar</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>elowriter</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>server.persistence.EloWriterMain</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>

                    <execution>
                        <id>loadtest-jar</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>loadtest</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>loadtest.LoadTestMain</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>